# Example S3 configuration - copy into your script project's resources as
# s3.properties. See application.properties.example for the full explanation
# of environment-variable resolution.
#
# Note: on AWS infrastructure prefer IAM roles / instance profiles over static
# keys entirely. When static keys are unavoidable, keep them out of this file:

region = us-east-1
accessKeyId = ${ENV:AWS_ACCESS_KEY_ID}
secretAccessKey = ${ENV:AWS_SECRET_ACCESS_KEY}

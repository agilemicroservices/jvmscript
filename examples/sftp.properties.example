# SFTP configuration (SftpUtility)
# Copy into your script project's resources as sftp.properties and load with:
#     sFtpOpenConnection("sftp.properties")
# or fold the keys into application.properties for the no-arg sFtpOpenConnection().
#
# Every key can instead come from an environment variable (which always wins):
#     sftp.server -> SFTP_SERVER      sftp.port     -> SFTP_PORT
#     sftp.user   -> SFTP_USER        sftp.password -> SFTP_PASSWORD
#     sftp.identity -> SFTP_IDENTITY
# With all values in the environment, no properties file is needed at all.

sftp.server = sftp.example.com
sftp.port = 22
# username/password from SFTP_USER / SFTP_PASSWORD by convention, or reference
# a specific variable explicitly:
#sftp.user = ${ENV:SFTP_PROD_USER}
#sftp.password = ${ENV:SFTP_PROD_PASSWORD}
# private key authentication instead of a password:
#sftp.identity = /home/batchuser/.ssh/id_rsa

# Host key verification is ON by default (checks ~/.ssh/known_hosts). To pin a
# key or opt out, use sFtpSetKnownHostsFile() / sFtpSetHostKeyFingerprint() /
# sFtpDisableHostKeyVerification() in the script before connecting.
